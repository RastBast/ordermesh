# Copy to .env and adjust. Loaded by docker-compose / your shell.
APP_ENV=dev
LOG_LEVEL=debug

HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_SHUTDOWN_TIMEOUT=15s

POSTGRES_DSN=postgres://order:order@localhost:5432/orders?sslmode=disable
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=2

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=10m

KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=orders.events
KAFKA_CLIENT_ID=order-service

OUTBOX_POLL_INTERVAL=2s
OUTBOX_BATCH_SIZE=100

METRICS_ADDR=:9090
OTEL_SERVICE_NAME=order-service
# Leave empty to disable trace export
OTLP_ENDPOINT=
TRACE_SAMPLE_RATIO=1.0

# ---- Security (Zero Trust) ----
# Set false ONLY for local dev. Forbidden in prod (config validation enforces it).
AUTH_ENABLED=true
# OIDC / JWKS: the service validates JWT signatures against these public keys.
JWKS_URL=https://idp.example.com/.well-known/jwks.json
JWT_ISSUER=https://idp.example.com
JWT_AUDIENCE=order-service

# PII encryption-at-rest keyring. Comma-separated base64 of 32-byte keys,
# OLDEST→NEWEST (newest is the active key; rotation = append a new key).
# Generate one with: openssl rand -base64 32
PII_ENCRYPTION_KEYS=

# Rate limiting (per principal/IP): local token bucket + Redis distributed quota.
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100

# Idempotency-Key retention.
IDEMPOTENCY_TTL=24h
